@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
<div class="box">
<label class="header">DEBUG</label><br/>
<br/>
<span>
	<label class="line">Current Player: @Turn</label><br/>
	
</span>
<span>
<label class="line">Current State: @State</label><br/>
</span>
<br/>
@foreach(string a in Debug)
	{
		<span>
			<label class="line">@a</label><br/>
		</span>
	}
</div>
</root>

@code
{
    [Property] public GameManagerBot gameManager {get; set;}
    [Property] public BottleLogic bottleLogic {get; set;}
    [Property, TextArea] public string State { get; set; }
    [Property, TextArea] public string Turn { get; set; }
    [Property, TextArea] public string[] Debug { get; set; }

    protected override void OnUpdate()
    {
		if(bottleLogic.DebugInfo() != null)
		{
			Debug = bottleLogic.DebugInfo();
		}
		Turn = gameManager.CurrentPlayer.ToString();
		State = gameManager.CurrentGameState.ToString();
		
    }
    /// <summary>
	/// the hash determines if the system should be rebuilt. If it changes, it will be rebuilt
	/// </summary>
	protected override int BuildHash() => System.HashCode.Combine( Debug, Turn, State );

}